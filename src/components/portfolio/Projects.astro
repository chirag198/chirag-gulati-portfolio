---
import SectionHeader from "../ui/SectionHeader.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../../utils/projects";

const work = projects.filter((p) => p.category === "work");
const featured = work.filter((p) => p.featured);
const rest = work.filter((p) => !p.featured);
const oddLead = featured.length % 2 === 1;

const hobby = projects.filter((p) => p.category === "hobby");
---

<section class="section" id="projects">
  <SectionHeader
    index="03"
    label="work"
    title="Work & client projects"
    lede="Platforms I've architected or led at work, and production sites built for clients."
  />
  <div class="bento bento--featured" data-stagger>
    {featured.map((p, i) => <ProjectCard project={p} variant="featured" wide={oddLead && i === 0} />)}
  </div>
  {rest.length > 0 && (
    <div class="bento bento--rest" data-stagger>
      {rest.map((p) => <ProjectCard project={p} />)}
    </div>
  )}
</section>

<section class="section section--ride" id="hobby-builds" data-ride>
  <div class="ride__head">
    <SectionHeader
      index="04"
      label="builds"
      title="Things I build for fun"
      lede="Agent systems, trading bots, and tooling I build on nights and weekends — mostly on Claude."
    />
    <p class="ride__counter" aria-hidden="true"><span data-ride-count>01</span> / {String(hobby.length).padStart(2, "0")}</p>
  </div>
  <div class="ride__viewport">
    <div class="ride__track" data-ride-track>
      {hobby.map((p, i) => <ProjectCard project={p} variant="ride" index={i} />)}
    </div>
  </div>
  <div class="ride__bar" aria-hidden="true"><span data-ride-bar></span></div>
</section>

<style>
  .section {
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 40px;
  }
  .bento {
    display: grid;
    gap: 16px;
  }
  .bento--featured { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .bento--rest {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 16px;
  }

  .ride__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .ride__counter {
    margin: 0 0 44px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .ride__counter span {
    font-size: 1.75rem;
    font-weight: 700;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ride__track {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .ride__bar { display: none; }

  /* Desktop with motion: one long horizontal ride, pinned by motion.ts */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .section--ride {
      max-width: none;
      padding-left: max(24px, calc((100vw - 1072px) / 2));
      padding-right: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .ride__head { max-width: 1072px; padding-right: 24px; }
    .ride__viewport { overflow: visible; }
    .ride__track {
      display: flex;
      align-items: flex-start;
      width: max-content;
      padding-right: 20vw;
      will-change: transform;
    }
    .ride__track :global(.card) {
      width: 420px;
      flex: 0 0 420px;
    }
    .ride__track :global(.card:first-child) {
      width: 560px;
      flex-basis: 560px;
    }
    .ride__bar {
      display: block;
      margin-top: 36px;
      max-width: 1072px;
      margin-right: 24px;
      height: 2px;
      border-radius: 2px;
      background: var(--border);
      overflow: hidden;
    }
    .ride__bar span {
      display: block;
      height: 100%;
      width: 100%;
      background: var(--grad);
      transform-origin: left;
      transform: scaleX(0);
    }
  }

  @media (max-width: 900px) {
    .section { padding: 64px 16px; }
    .bento--rest { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .bento--featured, .bento--rest, .ride__track { grid-template-columns: 1fr; }
    .ride__counter { display: none; }
  }
</style>
