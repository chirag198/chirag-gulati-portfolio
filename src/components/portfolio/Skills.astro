---
import SectionHeader from "../ui/SectionHeader.astro";
import { skillGroups } from "../../utils/skills";

const hues = ["--accent-3", "--accent-2", "--accent", "--accent-4", "--accent-5", "--accent"];
---

<section class="section" id="stack" aria-labelledby="stack-title">
  <SectionHeader
    index="01"
    label="stack"
    title="What I work with"
    lede="Agentic AI on top of the backend, infrastructure, and security fundamentals it needs to run in production."
  />
  <div class="stack" data-stagger>
    {skillGroups.map((group, i) => (
      <div class="stack__group" style={`--hue: var(${hues[i % hues.length]})`}>
        <p class="stack__label">{group.label}/</p>
        <ul class="stack__items">
          {group.items.map((item) => <li data-pop>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .section {
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 40px;
  }
  .stack {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .stack__group {
    position: relative;
    background: var(--bg-elev);
    padding: 22px 24px 24px;
    overflow: hidden;
  }
  .stack__group::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(360px circle at 100% 0%, color-mix(in srgb, var(--hue) 16%, transparent), transparent 70%);
    opacity: 0.35;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .stack__group:hover::before { opacity: 1; }
  .stack__label {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--hue);
    margin: 0 0 14px;
  }
  .stack__label::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--hue) 20%, transparent);
  }
  .stack__items {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack__items li {
    font-size: 0.8125rem;
    color: var(--text-2);
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--bg-sunk);
    border: 1px solid var(--border);
    transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .stack__items li:hover {
    border-color: color-mix(in srgb, var(--hue) 60%, transparent);
    background: color-mix(in srgb, var(--hue) 10%, var(--bg-sunk));
    color: var(--text);
    box-shadow: 0 6px 18px -8px color-mix(in srgb, var(--hue) 70%, transparent);
  }
  @media (max-width: 900px) {
    .section { padding: 64px 16px; }
    .stack { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .stack { grid-template-columns: 1fr; }
  }
</style>
