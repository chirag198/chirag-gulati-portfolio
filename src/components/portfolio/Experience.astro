---
import SectionHeader from "../ui/SectionHeader.astro";
import { experiences } from "../../utils/experience";

const SHOWN = 3;
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <SectionHeader index="02" label="experience" title="Where I've shipped" />
  <div class="coaster-wrap" data-coaster>
  <svg class="coaster" aria-hidden="true">
    <defs>
      <linearGradient id="coaster-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)" />
        <stop offset="50%" stop-color="var(--accent-2)" />
        <stop offset="100%" stop-color="var(--accent-3)" />
      </linearGradient>
    </defs>
    <path class="coaster__rail" />
    <path class="coaster__ties" />
    <path class="coaster__halo" data-coaster-drawn />
    <path class="coaster__drawn" data-coaster-drawn />
    <g class="coaster__cart">
      <circle class="coaster__cart-halo" r="14" />
      <rect x="-9" y="-6" width="18" height="12" rx="3" />
      <circle cx="-5" cy="7" r="2.2" />
      <circle cx="5" cy="7" r="2.2" />
    </g>
  </svg>
  <ol class="timeline">
    {experiences.map((exp) => {
      const [start, end] = exp.period.split(" — ");
      const current = end === "Present";
      return (
        <li class="role" data-reveal>
          <span class="role__node" data-coaster-node aria-hidden="true"></span>
          <div class="role__when">
            <span class={current ? "role__badge role__badge--now" : "role__badge"}>{current ? "now" : end}</span>
            <span class="role__start">since {start}</span>
          </div>
          <div class="role__body">
            <h3 class="role__title">{exp.position}</h3>
            <p class="role__company">{exp.company} <span>· {exp.location}</span></p>
            <p class="role__desc">{exp.description}</p>
            <ul class="role__points">
              {exp.highlights.slice(0, SHOWN).map((h) => <li>{h}</li>)}
            </ul>
            {exp.highlights.length > SHOWN && (
              <details class="role__more">
                <summary>+{exp.highlights.length - SHOWN} more</summary>
                <ul class="role__points">
                  {exp.highlights.slice(SHOWN).map((h) => <li>{h}</li>)}
                </ul>
              </details>
            )}
            {exp.technologies && <p class="role__tech">{exp.technologies.join("  ·  ")}</p>}
          </div>
        </li>
      );
    })}
  </ol>
  </div>
</section>

<style>
  .section {
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 40px;
  }
  .coaster-wrap {
    position: relative;
    --track-x: 232px;
  }
  .coaster {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .coaster__rail,
  .coaster__drawn,
  .coaster__halo,
  .coaster__ties {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .coaster__rail {
    stroke: var(--border-strong);
    stroke-width: 2;
  }
  .coaster__ties {
    stroke: var(--border);
    stroke-width: 8;
    stroke-dasharray: 2 10;
  }
  .coaster__drawn {
    stroke: url(#coaster-grad);
    stroke-width: 2.5;
  }
  .coaster__halo {
    stroke: url(#coaster-grad);
    stroke-width: 10;
    opacity: 0.16;
  }
  .coaster__cart {
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .coaster__cart-halo {
    fill: var(--accent-2);
    opacity: 0.22;
  }
  .coaster__cart rect { fill: var(--accent-2); }
  .coaster__cart circle { fill: var(--text); }
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .role {
    position: relative;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    column-gap: 80px;
    padding: 32px 0;
    border-top: 1px solid var(--border);
  }
  .role:first-child { border-top: 0; padding-top: 0; }
  .role__node {
    position: absolute;
    left: calc(var(--track-x) - 7px);
    top: 36px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    background: var(--bg);
    z-index: 1;
    transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .role:first-child .role__node { top: 4px; }
  .role__node.is-active {
    border-color: var(--accent-2);
    background: var(--accent-2);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent-2) 18%, transparent), 0 0 18px color-mix(in srgb, var(--accent-2) 70%, transparent);
    transform: scale(1.15);
  }
  .role {
    transition: background 0.3s ease;
  }
  .role:hover .role__title {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .role__when {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .role__badge {
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-2);
  }
  .role__badge--now {
    position: relative;
    border-color: color-mix(in srgb, var(--accent) 35%, transparent);
    background: var(--accent-soft);
    color: var(--accent);
    padding-left: 20px;
  }
  .role__badge--now::before {
    content: "";
    position: absolute;
    left: 8px;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--accent);
    animation: live 1.8s ease-out infinite;
  }
  @keyframes live {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
    100% { box-shadow: 0 0 0 7px transparent; }
  }
  .role__title {
    font-size: 1.25rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0;
  }
  .role__company {
    margin: 4px 0 0;
    color: var(--text-2);
    font-weight: 500;
  }
  .role__company span { color: var(--muted); font-weight: 400; }
  .role__desc {
    margin: 14px 0 0;
    color: var(--muted);
    line-height: 1.65;
    max-width: 70ch;
  }
  .role__points {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    max-width: 72ch;
  }
  .role__points li {
    position: relative;
    padding-left: 20px;
    color: var(--text-2);
    line-height: 1.6;
    font-size: 0.9375rem;
  }
  .role__points li::before {
    content: "›";
    position: absolute;
    left: 2px;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .role__more summary {
    margin-top: 10px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    list-style: none;
    width: fit-content;
  }
  .role__more summary::-webkit-details-marker { display: none; }
  .role__more summary:hover { color: var(--text); }
  .role__more[open] summary { display: none; }
  .role__more .role__points { margin-top: 8px; }
  .role__tech {
    margin: 18px 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.8;
    white-space: pre-wrap;
  }
  @media (max-width: 760px) {
    .section { padding: 64px 16px; }
    .coaster, .role__node { display: none; }
    .role { grid-template-columns: 1fr; gap: 12px; }
    .role__when { flex-direction: row; align-items: center; }
  }
</style>
