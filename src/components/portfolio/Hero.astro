---
import { config } from "../../utils/config";

const mission = [
  { state: "done", hero: "black-widow", task: "recon", meta: "2m" },
  { state: "done", hero: "shuri", task: "research", meta: "4m" },
  { state: "done", hero: "ironheart", task: "design · ADR", meta: "6m" },
  { state: "done", hero: "nick-fury", task: "pre-mortem", meta: "approved" },
  { state: "run", hero: "iron-man", task: "build", meta: "running" },
  { state: "wait", hero: "doctor-strange", task: "review", meta: "queued" },
];
const glyph = { done: "✓", run: "●", wait: "○" } as const;

const nameWords = config.name.split(" ").map((w) => w.split(""));
const parseStat = (v: string) => {
  const m = v.match(/^(\d+)(.*)$/);
  return m ? { n: m[1], suffix: m[2] } : { n: "", suffix: v };
};
---

<section class="hero" id="home" aria-label="Introduction" data-pause-offscreen>
  <div class="hero__aurora" aria-hidden="true">
    <span class="hero__blob hero__blob--a"></span>
    <span class="hero__blob hero__blob--b"></span>
    <span class="hero__blob hero__blob--c"></span>
    <span class="hero__cursor" data-hero-cursor></span>
  </div>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__inner">
    <div class="hero__copy" data-hero-copy>
      <p class="hero__status" data-hero-fade>
        <img src="/IMG_0320.jpg" alt="" class="hero__avatar" width="28" height="28" />
        <span class="hero__dot" aria-hidden="true"></span>
        {config.location} · UTC+5:30
      </p>

      <p class="hero__prompt" data-hero-fade><span>$</span> whoami</p>
      <h1 class="hero__name" aria-label={config.name} data-hero-name>
        {nameWords.map((word, w) => (
          <span class={w === nameWords.length - 1 ? "hero__word hero__word--color" : "hero__word"} aria-hidden="true">
            {word.map((ch, i) => (
              <span class="hero__char" style={`--i:${i};--p:${word.length > 1 ? i / (word.length - 1) : 0}`}>{ch}</span>
            ))}
          </span>
        ))}
      </h1>
      <p class="hero__headline" data-hero-fade>{config.headline}</p>
      <p class="hero__summary" data-hero-fade>{config.summary}</p>

      <div class="hero__actions" data-hero-fade>
        <a href={config.resumeDownloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn--solid">
          Resume
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 2v9m0 0 3.5-3.5M8 11 4.5 7.5M3 14h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href={config.github} target="_blank" rel="noopener noreferrer" class="btn">github</a>
        <a href={config.linkedIn} target="_blank" rel="noopener noreferrer" class="btn">linkedin</a>
        <a href={`mailto:${config.email}`} class="btn">email</a>
      </div>
    </div>

    <figure class="term" data-hero-term data-tilt aria-label="Example run of the Avengers multi-agent orchestrator">
      <div class="term__bar">
        <span class="term__lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="term__title">zsh — avengers</span>
      </div>
      <div class="term__body" role="img" aria-label="An avengers mission: recon, research, design and pre-mortem done; build running; review queued.">
        <p class="term__line" style="--i:0"><span class="term__ps">~/aisquare</span> <span class="term__accent">$</span> avengers "#1050 relay workspace webhooks"</p>
        <p class="term__line term__muted" style="--i:1">assembling team · 10 heroes · cap leads</p>
        {mission.map((m, i) => (
          <p class={`term__line term__row term__row--${m.state}`} style={`--i:${i + 2}`}>
            <span class="term__glyph">{glyph[m.state as keyof typeof glyph]}</span>
            <span class="term__hero">{m.hero}</span>
            <span class="term__task">{m.task}</span>
            <span class="term__meta">{m.meta}</span>
          </p>
        ))}
        <p class="term__line" style={`--i:${mission.length + 2}`}><span class="term__ps">~/aisquare</span> <span class="term__accent">$</span> <span class="term__cursor" aria-hidden="true"></span></p>
      </div>
    </figure>
  </div>

  <dl class="stats" data-reveal>
    {config.stats.map((s) => (
      <div class="stats__item">
        <dt class="stats__value grad-text"><span data-count={parseStat(s.value).n}>{parseStat(s.value).n}</span>{parseStat(s.value).suffix}</dt>
        <dd class="stats__label">{s.label}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .hero {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    padding: 96px 24px 72px;
  }
  .hero__aurora {
    position: absolute;
    inset: -120px -30vw 0;
    z-index: -2;
    overflow: hidden;
    pointer-events: none;
  }
  .hero__blob {
    position: absolute;
    width: 620px;
    height: 620px;
    border-radius: 50%;
    opacity: 1;
    will-change: transform;
  }
  .hero__blob--a {
    top: -120px;
    left: 38%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 22%, transparent), transparent 62%);
    animation: drift-a 22s ease-in-out infinite alternate;
  }
  .hero__blob--b {
    top: 80px;
    left: 62%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-3) 24%, transparent), transparent 62%);
    animation: drift-b 26s ease-in-out infinite alternate;
  }
  .hero__blob--c {
    top: 240px;
    left: 20%;
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 16%, transparent), transparent 62%);
    animation: drift-c 30s ease-in-out infinite alternate;
  }
  .hero__cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 18%, transparent), transparent 62%);
    opacity: 0;
    transition: opacity 0.4s ease;
    will-change: transform;
  }
  .hero:hover .hero__cursor { opacity: 1; }
  @keyframes drift-a {
    to { transform: translate3d(-140px, 90px, 0) scale(1.15); }
  }
  @keyframes drift-b {
    to { transform: translate3d(-220px, -60px, 0) scale(0.9); }
  }
  @keyframes drift-c {
    to { transform: translate3d(160px, -80px, 0) scale(1.2); }
  }
  .hero__grid {
    position: absolute;
    inset: 0 -50vw;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 30%, transparent 75%);
    pointer-events: none;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 4px 14px 4px 4px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .hero__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }
  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .hero__prompt {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .hero__prompt span {
    color: var(--accent);
  }
  .hero__word {
    display: inline-flex;
    overflow: hidden;
    padding: 0.12em 0.04em 0.08em;
    margin: -0.12em -0.04em -0.08em;
  }
  .hero__word + .hero__word { margin-left: 0.22em; }
  .hero__char {
    display: inline-block;
  }
  /* Hover wave; motion.ts adds .is-animating during the intro so the two never fight. */
  .hero__name:not(.is-animating) .hero__char {
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: calc(var(--i) * 28ms);
  }
  .hero__word--color .hero__char {
    color: color-mix(in oklch, var(--accent) calc(100% - var(--p) * 100%), var(--accent-3));
  }
  .hero__name:hover .hero__char {
    transform: translateY(-0.08em) rotate(-3deg);
  }
  .hero__name {
    font-size: clamp(2.75rem, 6.5vw, 4.75rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
    margin: 0;
    color: var(--text);
  }
  .hero__headline {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--text-2);
    margin: 20px 0 0;
    max-width: 30ch;
  }
  .hero__summary {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    margin: 16px 0 0;
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1px solid var(--border-strong);
    background: var(--bg-elev);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.2s ease;
  }
  .btn:hover {
    border-color: var(--text);
  }
  .btn--solid {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  .btn:hover {
    box-shadow: 0 8px 24px -10px color-mix(in srgb, var(--accent-2) 60%, transparent);
  }
  .btn--solid {
    position: relative;
    isolation: isolate;
  }
  .btn--solid::before {
    content: "";
    position: absolute;
    inset: -2px;
    z-index: -1;
    border-radius: 10px;
    background: var(--grad);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .btn--solid:hover::before { opacity: 1; }
  .btn--solid:hover { box-shadow: var(--glow); }

  /* Terminal */
  .term {
    margin: 0;
    transform-style: preserve-3d;
    will-change: transform;
    border-radius: 14px;
    border: 1px solid var(--term-border);
    background: var(--term-bg);
    box-shadow:
      var(--shadow),
      0 30px 80px -24px color-mix(in srgb, var(--accent) 35%, transparent),
      0 40px 120px -40px color-mix(in srgb, var(--accent-3) 45%, transparent);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--term-text);
  }
  .term__bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 14px;
    border-bottom: 1px solid var(--term-border);
  }
  .term__lights {
    display: flex;
    gap: 7px;
  }
  .term__lights i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ff5f57;
  }
  .term__lights i:nth-child(2) { background: #febc2e; }
  .term__lights i:nth-child(3) { background: #28c840; }
  .term__title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--term-muted);
    font-size: 0.75rem;
  }
  .term__body {
    padding: 18px 18px 22px;
    min-height: 300px;
  }
  .term__line {
    margin: 0 0 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(4px);
    animation: line-in 0.35s ease forwards;
    animation-delay: calc(var(--i) * 380ms + 250ms);
  }
  .term__ps { color: var(--term-muted); }
  .term__accent { color: var(--term-accent); }
  .term__muted { color: var(--term-muted); }
  .term__row {
    display: grid;
    grid-template-columns: 18px 128px 1fr auto;
    gap: 8px;
    padding-left: 4px;
  }
  .term__glyph { color: var(--term-accent); }
  .term__hero { color: var(--term-text); }
  .term__task { color: var(--term-muted); }
  .term__meta { color: var(--term-muted); text-align: right; }
  .term__row--run .term__glyph { animation: pulse 1.2s ease-in-out infinite; }
  .term__row--run .term__meta { color: var(--term-accent); }
  .term__row--wait .term__glyph,
  .term__row--wait .term__hero { color: var(--term-muted); }
  .term__cursor {
    display: inline-block;
    width: 8px;
    height: 15px;
    vertical-align: -2px;
    background: var(--term-accent);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes line-in {
    to { opacity: 1; transform: none; }
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  @keyframes pulse {
    50% { opacity: 0.35; }
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 72px 0 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--bg-elev);
    overflow: hidden;
  }
  .stats__item {
    position: relative;
    padding: 22px 24px;
    border-left: 1px solid var(--border);
    transition: background 0.3s ease;
  }
  .stats__item::after {
    content: "";
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 0;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .stats__item:hover { background: var(--bg-sunk); }
  .stats__item:hover::after { transform: scaleX(1); }
  .stats__item:first-child { border-left: 0; }
  .stats__value {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .stats__label {
    margin: 4px 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .hero { padding: 56px 16px 48px; }
    .hero__inner { grid-template-columns: 1fr; gap: 40px; }
    .stats { grid-template-columns: repeat(2, 1fr); margin-top: 48px; }
    .stats__item:nth-child(3) { border-left: 0; }
    .stats__item:nth-child(n + 3) { border-top: 1px solid var(--border); }
  }
  @media (max-width: 480px) {
    .term { font-size: 0.72rem; }
    .term__row { grid-template-columns: 14px 104px 1fr auto; gap: 6px; }
    .term__body { min-height: 0; padding: 14px; }
  }
</style>
