---
import type { Project } from "../../utils/projects";

interface Props {
  project: Project;
  variant?: "featured" | "compact" | "ride";
  wide?: boolean;
  index?: number;
}
const { project: p, variant = "compact", wide = false, index } = Astro.props;

const host = p.link
  ? (() => {
      const url = new URL(p.link);
      return url.hostname === "github.com" ? "github" : url.hostname.replace(/^www\./, "");
    })()
  : "private";
const kind = !p.link ? "private" : host === "github" ? "code" : "live";
const Tag = p.link ? "a" : "div";
const showDetails = variant !== "compact" && p.details;
---

<Tag
  class:list={["card", `card--${variant}`, { "card--wide": wide, "card--link": p.link }]}
  data-tilt
  {...(p.link ? { href: p.link, target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span class="card__ring" aria-hidden="true"></span>
  <span class="card__spot" aria-hidden="true"></span>
  <div class="card__top">
    <span class="card__host" data-kind={kind}>{host}</span>
    {index !== undefined && <span class="card__index">{String(index + 1).padStart(2, "0")}</span>}
    {p.link && <span class="card__arrow" aria-hidden="true">↗</span>}
  </div>
  <h3 class="card__title">{p.title}</h3>
  <p class="card__desc">{p.description}</p>
  {showDetails && (
    <ul class="card__points">
      {p.details!.map((d) => <li>{d}</li>)}
    </ul>
  )}
  {p.technologies && <p class="card__tech">{p.technologies.join(" · ")}</p>}
</Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    --mx: 50%;
    --my: 50%;
  }
  .card--featured,
  .card--ride { padding: 28px; }
  .card--wide { grid-column: 1 / -1; }
  .card:hover {
    border-color: transparent;
    box-shadow: var(--glow);
  }
  .card__ring {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--ring-angle), var(--accent), var(--accent-2), var(--accent-3), var(--accent-4), var(--accent));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .card:hover .card__ring {
    opacity: 1;
    animation: ring-spin 3.5s linear infinite;
  }
  @keyframes ring-spin {
    to { --ring-angle: 360deg; }
  }
  .card__spot {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(380px circle at var(--mx) var(--my), color-mix(in srgb, var(--accent-2) 12%, transparent), transparent 60%),
      radial-gradient(600px circle at var(--mx) var(--my), color-mix(in srgb, var(--accent-3) 8%, transparent), transparent 70%);
    transition: opacity 0.25s ease;
  }
  .card:hover .card__spot { opacity: 1; }
  .card--featured::after,
  .card--ride::after {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent) 25%, var(--accent-2) 50%, var(--accent-3) 75%, transparent);
    opacity: 0.7;
  }
  .card__top {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .card__host {
    --tag: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-radius: 6px;
    color: var(--tag);
    background: color-mix(in srgb, var(--tag) 9%, var(--bg-sunk));
    border: 1px solid color-mix(in srgb, var(--tag) 28%, var(--border));
  }
  .card__host::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--tag);
  }
  .card__host[data-kind="live"] { --tag: var(--accent); }
  .card__host[data-kind="code"] { --tag: var(--accent-3); }
  .card__index { margin-left: auto; }
  .card__arrow {
    margin-left: auto;
    font-size: 0.95rem;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .card__index + .card__arrow { margin-left: 0; }
  .card--link:hover .card__arrow {
    color: var(--accent-2);
    transform: translate(2px, -2px);
  }
  .card__title {
    position: relative;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--text);
    margin: 0;
  }
  .card--featured .card__title,
  .card--ride .card__title { font-size: 1.3125rem; }
  .card__desc {
    position: relative;
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .card__points {
    position: relative;
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  .card--wide .card__points { grid-template-columns: 1fr 1fr; column-gap: 28px; }
  .card__points li {
    position: relative;
    padding-left: 18px;
    color: var(--text-2);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .card__points li::before {
    content: "›";
    position: absolute;
    left: 2px;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .card__tech {
    position: relative;
    margin: auto 0 0;
    padding-top: 20px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.7;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .card--wide .card__points { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .card--featured, .card--ride { padding: 22px; }
  }
</style>
