---
import Navigation from "./Navigation.astro";
import ThemeIcon from "../ui/ThemeIcon.astro";
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const { github, githubIconName, linkedin, linkedinIconName } = staticData.data;

// Consistent navigation items across all pages
const navItems = ["home", "experience", "projects", "hobbies", "about", "blog"];
---

<header role="banner" aria-label="Main navigation" class="site-header">
  <div class="site-header__inner">
    <a href="/" aria-label="Go to home" class="site-logo">
      <span class="site-logo__mark">cg</span>
      <span class="site-logo__path">~/chirag-gulati</span>
    </a>

    <Navigation items={navItems} />

    <div class="site-header__actions">
      <div class="site-header__social" role="group">
        <Social link={github} iconName={githubIconName} />
        <Social link={linkedin} iconName={linkedinIconName} />
      </div>
      <ThemeIcon />
      <button
        class="hamburger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="bars" class="hamburger-icon bars-icon" aria-hidden="true" />
        <Icon name="xmark" class="hamburger-icon xmark-icon" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .site-header__inner {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .site-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-logo__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: -0.02em;
  }
  .site-logo__path {
    color: var(--muted);
  }
  .site-logo:hover .site-logo__path {
    color: var(--text);
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 1.05rem;
    color: var(--muted);
  }
  .site-header__social {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .site-header__actions :global(a:hover),
  .site-header__actions :global(button:hover) {
    color: var(--text);
  }
  @media (max-width: 767px) {
    .site-header__inner { padding: 0 16px; }
    .site-logo__path { display: none; }
    .site-header__social { display: none; }
  }
</style>
