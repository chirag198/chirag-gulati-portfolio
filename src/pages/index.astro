---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/portfolio/Hero.astro";
import Skills from "../components/portfolio/Skills.astro";
import Experience from "../components/portfolio/Experience.astro";
import Projects from "../components/portfolio/Projects.astro";
import CallToAction from "../components/portfolio/CallToAction.astro";
import Marquee from "../components/portfolio/Marquee.astro";
import { config } from "../utils/config";

const pageTitle = config.name + " | " + config.title;
const pageDescription = config.description;
const OGImage = {
  alt: config.name + " Portfolio",
  url: "/images/portfolio.webp"
};
---

<Layout pageTitle={pageTitle} description={pageDescription} ogimage={OGImage}>
  <div class="scroll-progress" aria-hidden="true" data-progress></div>
  <main>
    <Hero />
    <Marquee />
    <Skills />
    <Experience />
    <Projects />
    <CallToAction />
  </main>
</Layout>

<script>
  import "../scripts/motion";
</script>

<style is:global>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    background: var(--grad);
    transform-origin: left;
    transform: scaleX(0);
    box-shadow: 0 0 12px color-mix(in srgb, var(--accent-2) 70%, transparent);
    pointer-events: none;
  }
</style>
